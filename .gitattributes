# Generated files are compared byte-for-byte against the generator's
# output (which emits LF) by the drift test, so git must never rewrite
# their line endings on checkout.
resources/nitr-types.lua text eol=lf
resources/nitr-api.md text eol=lf
crates/nitr-cli/src/nitr-api.toml text eol=lf
# Lua sources are embedded via include_str! and shipped into scaffolds;
# keep them LF everywhere too.
*.lua text eol=lf
# Vendored Swagger UI: third-party, minified, reviewed by checksum in
# update.sh rather than by diff.
crates/nitr-http/assets/swagger-ui/* linguist-vendored -diff
crates/nitr-http/assets/swagger-ui/* text eol=lf
