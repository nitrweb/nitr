# libFuzzer dictionary for the `tls_pem` target.
#
# The input is `u8 use_min | min-version \0 certificate PEM \0 key PEM`,
# so the NUL that ends each field is itself a structural token — without
# it the whole input is one min_version string and both PEM halves are
# empty.
"\x00"

# `min_version`: the two accepted spellings, the deprecated ones that must
# always be refused, and the near misses a typo produces.
"1.2"
"1.3"
"1.1"
"1.0"
"TLSv1.2"
"TLSv1.3"
"tls1.3"

# PEM framing. The five dashes on each side are the whole grammar: a
# header, a base64 body, a matching footer. Getting the two labels to
# agree is what libFuzzer would otherwise have to discover byte by byte.
"-----BEGIN "
"-----END "
"-----"
"\x0a"
"\x0d\x0a"

# The labels that matter, in both halves. `rustls_pemfile` dispatches on
# the label text, so a mismatched pair (a key block where a certificate
# belongs) is the interesting confusion to synthesize.
"-----BEGIN CERTIFICATE-----"
"-----END CERTIFICATE-----"
"-----BEGIN PRIVATE KEY-----"
"-----END PRIVATE KEY-----"
"-----BEGIN RSA PRIVATE KEY-----"
"-----END RSA PRIVATE KEY-----"
"-----BEGIN EC PRIVATE KEY-----"
"-----END EC PRIVATE KEY-----"

# Labels the loader must NOT accept as either half: a public key, a
# request, a bundle of parameters, an encrypted key with no passphrase.
"-----BEGIN PUBLIC KEY-----"
"-----BEGIN CERTIFICATE REQUEST-----"
"-----BEGIN ENCRYPTED PRIVATE KEY-----"
"-----BEGIN DH PARAMETERS-----"
"-----BEGIN TRUSTED CERTIFICATE-----"
"Proc-Type: 4,ENCRYPTED"
"DEK-Info: AES-128-CBC"

# Base64 payload fragments. `MII` opens every DER SEQUENCE long enough to
# be a certificate or a PKCS#8 key, so it is the prefix a body needs to
# get past the base64 layer and reach the DER parser.
"MII"
"MIIB"
"MIIC"
"MIIE"
"MIGH"
"AAAA"
"="
"=="
"AQAB"
